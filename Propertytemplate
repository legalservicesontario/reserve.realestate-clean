<!-- ========================================================= -->
<!-- JAVASCRIPT -->
<!-- ========================================================= -->

<script>

(function () {


    /* =========================================================
       PROPERTY ID
    ========================================================= */

    const PROPERTY_ID =
        'dr-cocotal-villa';



    /* =========================================================
       MOBILE MENU
    ========================================================= */

    const menuButton =
        document.getElementById('menuButton');

    const mobileMenu =
        document.getElementById('mobileMenu');


    if (menuButton) {

        menuButton.addEventListener('click', function () {

            mobileMenu.classList.toggle('active');

        });

    }


    document.querySelectorAll('#mobileMenu a')
        .forEach(function (link) {

            link.addEventListener('click', function () {

                mobileMenu.classList.remove('active');

            });

        });



    /* =========================================================
       SAVED / LIKED PROPERTY
    ========================================================= */

    const likeButton =
        document.getElementById('likeButton');

    const likeHeart =
        document.getElementById('likeHeart');

    const likeText =
        document.getElementById('likeText');


    function getSavedListings() {

        try {

            return JSON.parse(
                localStorage.getItem('savedListings') || '[]'
            );

        } catch (error) {

            return [];

        }

    }


    function setSavedListings(listings) {

        localStorage.setItem(
            'savedListings',
            JSON.stringify(listings)
        );

    }


    function isSaved() {

        return getSavedListings()
            .includes(PROPERTY_ID);

    }


    function updateLikeButton() {

        const saved = isSaved();


        likeHeart.textContent =
            saved ? '♥' : '♡';


        likeText.textContent =
            saved ? 'Liked' : 'Like';


        likeButton.classList.toggle(
            'saved',
            saved
        );


        likeButton.setAttribute(
            'aria-pressed',
            String(saved)
        );

    }


    if (likeButton) {

        likeButton.addEventListener(
            'click',
            function () {


                /*
                 * Existing Reserve login logic.
                 *
                 * If there is no user email stored,
                 * send visitor to the main site.
                 */

                const userEmail =
                    localStorage.getItem('userEmail');


                if (!userEmail) {

                    window.location.href =
                        'index.html';

                    return;

                }


                const saved =
                    getSavedListings();


                const existingIndex =
                    saved.indexOf(PROPERTY_ID);


                if (existingIndex === -1) {

                    saved.push(PROPERTY_ID);

                } else {

                    saved.splice(
                        existingIndex,
                        1
                    );

                }


                setSavedListings(saved);

                updateLikeButton();

            }
        );

    }


    updateLikeButton();



    /* =========================================================
       GALLERY LIGHTBOX
    ========================================================= */

    const overlay =
        document.getElementById(
            'galleryOverlay'
        );


    const galleryImage =
        document.getElementById(
            'galleryImage'
        );


    const closeGallery =
        document.getElementById(
            'closeGallery'
        );


    document.querySelectorAll(
        '[data-gallery="true"]'
    ).forEach(function (image) {


        image.addEventListener(
            'click',
            function () {

                galleryImage.src =
                    image.src;

                galleryImage.alt =
                    image.alt;

                overlay.classList.add(
                    'active'
                );

            }
        );

    });


    function closeImageGallery() {

        overlay.classList.remove(
            'active'
        );

        galleryImage.src = '';

    }


    closeGallery.addEventListener(
        'click',
        closeImageGallery
    );


    overlay.addEventListener(
        'click',
        function (event) {

            if (event.target === overlay) {

                closeImageGallery();

            }

        }
    );


    document.addEventListener(
        'keydown',
        function (event) {

            if (
                event.key === 'Escape' &&
                overlay.classList.contains('active')
            ) {

                closeImageGallery();

            }

        }
    );



    /* =========================================================
       CONTACT FORM
       ========================================================= */

    const form =
        document.getElementById(
            'propertyInquiryForm'
        );


    const formMessage =
        document.getElementById(
            'formMessage'
        );


    form.addEventListener(
        'submit',
        function (event) {

            /*
             * Prevents the browser from attempting
             * to submit to a nonexistent endpoint.
             *
             * The Python / GitHub automation system
             * can later connect this form to:
             *
             * - Formspree
             * - Netlify Forms
             * - Email
             * - CRM
             * - Reserve API
             * - WhatsApp
             *
             */

            event.preventDefault();


            formMessage.classList.remove(
                'hidden'
            );


            form.reset();


            setTimeout(function () {

                formMessage.classList.add(
                    'hidden'
                );

            }, 6000);

        }
    );


})();

</script>


